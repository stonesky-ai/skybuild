# Copy to .env and set this installation's shared inference endpoint.
# Configuration contract only: the runtime adapter is not implemented yet.
SKYBUILD_INFERENCE_BASE_URL=
# Absolute path to an external file containing the endpoint's bearer token.
# Put the file path here, never the token itself. Do not commit the token file.
SKYBUILD_INFERENCE_SECRET_FILE=
# Private Workbench login: store password in this mode-0600 file, never here.
SKYBUILD_WORKBENCH_USERNAME=user1
SKYBUILD_WORKBENCH_PASSWORD_FILE=/path/to/private/skybuild-workbench-password
# This must be a separate scoped Workbench API credential, not the owner-token file.
SKYBUILD_WORKBENCH_TOKEN_FILE=/path/to/private/skybuild-workbench-api-token
# Fill with sha256:<image-id> from the reviewed local Workbench build.
SKYBUILD_WORKBENCH_IMAGE=
