#!/bin/sh
# Run project commands with this checkout's locked environment and source.
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
project_root=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)
if [ ! -f "$project_root/pyproject.toml" ] || [ ! -f "$project_root/uv.lock" ]; then
    echo 'project_python: expected pyproject.toml and uv.lock beside scripts' >&2
    exit 2
fi

# Do not let another checkout's editable environment or source override ours.
UV_PROJECT_ENVIRONMENT="$project_root/.venv"
PYTHONPATH="$project_root/src:$project_root/scripts:$project_root"
UV_CACHE_DIR="${UV_CACHE_DIR:-$project_root/.uv-cache}"
export UV_PROJECT_ENVIRONMENT PYTHONPATH UV_CACHE_DIR
unset UV_NO_SYNC UV_NO_PROJECT
exec uv run --locked --extra test --project "$project_root" python -P "$@"
